<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Rotation pinning for the glasses' compact mirror; appop granted by the user/adb. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
        Wi-Fi Direct, so the glasses can reach the phone with no router and no
        hotspot. NEARBY_WIFI_DEVICES is the Android 13+ permission and carries
        neverForLocation because this genuinely does not want the wearer's
        position — it wants one device in the same room. ACCESS_FINE_LOCATION
        is the pre-13 equivalent and is capped at 32 so it is not requested on
        newer releases, where the nearby-devices permission replaces it.

        Both are runtime permissions, and P2P discovery does not fail loudly
        without them: it returns an empty peer list, which reads as "the phone
        is not there".
    -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />

    <!--
        See the apps that have a launcher icon, so "open Spotify" can find
        Spotify. From Android 11 a package is invisible unless it is declared
        here, and queryIntentActivities would simply return an empty list.

        Scoped to MAIN/LAUNCHER rather than asking for QUERY_ALL_PACKAGES:
        that permission is the "see every package installed" one Play treats
        as sensitive, and this only needs the apps a person could tap on their
        own home screen anyway.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="X3Mira"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".DexInputService"
            android:exported="true"
            android:label="X3Mira input"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/dex_input_service" />
        </service>
        <service
            android:name=".CaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
        <!--
            API key delivery over adb, the same two doors x3hub uses: push a
            key file into the app's external files dir, or send the SET_API_KEY
            broadcast with a "key" string extra. See ApiKeyStore.
            exported=false keeps that broadcast door to adb/shell and this app.
        -->
        <receiver
            android:name=".ApiKeyBroadcastReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.x3mira.phone.SET_API_KEY" />
            </intent-filter>
        </receiver>
        <service
            android:name=".DexNotificationService"
            android:exported="false"
            android:label="X3Mira notifications"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
